{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eva:contracts:v1:agent-credentials",
  "title": "Agent Credentials",
  "description": "Shared authentication payload presented by an EVA Agent to establish trust with EVA Core.",
  "type": "object",

  "properties": {
    "contract_version": {
      "type": "string",
      "const": "1.0.0"
    },

    "agent_id": {
      "type": "string",
      "format": "uuid",
      "description": "Identifier of the agent presenting the credentials."
    },

    "issued_at": {
      "type": "string",
      "format": "date-time",
      "description": "UTC timestamp when the credentials were issued."
    },

    "schema": {
      "type": "string",
      "enum": [
        "bearer_token",
        "auth_request"
      ],
      "description": "Authentication scheme in use."
    },

    "auth_request": {
      "type": "object",
      "properties": {
        "nonce": {
          "type": "string",
          "minLength": 16,
          "maxLength": 64,
          "description": "Challenge to Core, proving liveness of the Agent."
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "When the challenge was generated."
        }
      },
      "required": [
        "nonce",
        "timestamp"
      ],
      "additionalProperties": false
    },

    "bearer_token": {
      "type": "string",
      "minLength": 16,
      "maxLength": 256,
      "description": "Pre-shared opaque token, presented in the HTTP Authorization header."
    }
  },

  "required": [
    "contract_version",
    "agent_id",
    "issued_at",
    "schema"
  ],

  "allOf": [
    {
      "if": {
        "properties": {
          "schema": {
            "const": "bearer_token"
          }
        },
        "required": ["schema"]
      },
      "then": {
        "required": ["bearer_token"],
        "not": {
          "required": ["auth_request"]
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema": {
            "const": "auth_request"
          }
        },
        "required": ["schema"]
      },
      "then": {
        "required": ["auth_request"],
        "not": {
          "required": ["bearer_token"]
        }
      }
    }
  ],

  "additionalProperties": false
}